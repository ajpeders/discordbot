# Note: the discordbot compose pulls its primary env_file from
# ../../apps/discordbot/.env (BOT_TOKEN, etc.). These DISCORDBOT_* vars
# below are the overrides read out of services/discordbot/.env by compose
# interpolation — see services/discordbot/docker-compose.yml.
DISCORDBOT_DOMAIN=discordbot.example.com
DISCORDBOT_IDLE_TIMEOUT=300
DISCORDBOT_YOUTUBE_API_KEY=
DISCORDBOT_LLM_CHAT_MODEL=
DISCORDBOT_LLM_API_BASE_URL=https://llm.example.com
DISCORDBOT_WEB_API_KEY=
DISCORDBOT_WEB_PASSWORD=
# Discord OAuth for the dashboard (optional). Create an application at
# https://discord.com/developers/applications, then under OAuth2 add the
# redirect URI below verbatim. Leave blank to use the shared password only.
DISCORDBOT_DISCORD_CLIENT_ID=
DISCORDBOT_DISCORD_CLIENT_SECRET=
DISCORDBOT_DISCORD_REDIRECT_URI=https://bot.example.com/api/auth/discord/callback
DISCORDBOT_MUSIC_DIR_HOST=/path/to/your/music
DISCORDBOT_DATA_DIR_HOST=/home/ween/.musicbot-data
